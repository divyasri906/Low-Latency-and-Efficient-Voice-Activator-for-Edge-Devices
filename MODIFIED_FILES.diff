+
+
+class TENet6NarrowIRDTModel(TENet6NarrowModel):
+    """
+    Our iRDT-fronted variant of the AUTHORS' TENet6Narrow.
+
+    Identical to TENet6NarrowModel in every respect -- same
+    build_inference(), i.e. the exact, unmodified authors'
+    audio_nets/tenet.py::TENet6Narrow() (n_channels=[16]*4,
+    n_strides=[2]*3, n_ratios=[3]*3, n_layers=[2]*3) -- EXCEPT the
+    feature extractor: preprocess() is overridden to call
+    irdt.preprocess.preprocess_irdt() instead of the base class's
+    preprocess_mfcc(). Nothing about TENet itself is touched.
+
+    audio_nets/tenet.py's tenet() function accepts `inputs` as any tensor
+    with a static rank>=3 shape (None, L, C, ...) -- it reads
+    inputs.shape[1] and inputs.shape[2] as L and C and reshapes generically
+    (`tf.reshape(inputs, [-1, L, 1, C])`), so feeding it iRDT's (batch,83,6)
+    feature tensor instead of MFCC's (batch,T,num_mfccs,1) requires no
+    change to tenet.py: L=83, C=6 are simply read from the iRDT tensor's
+    shape instead.
+    """
+
+    def preprocess(self, wavs):
+        return preprocess_irdt(wavs, **vars(self.args))
